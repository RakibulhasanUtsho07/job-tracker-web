# Local development PostgreSQL (change these values before any shared deployment).
POSTGRES_USER=hireflow
POSTGRES_PASSWORD=local-dev-only-change-me
POSTGRES_DB=hireflow
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hireflow:local-dev-only-change-me@127.0.0.1:5432/hireflow
# Set DATABASE_SSL=require for a managed database that requires TLS.
# DATABASE_SSL=require

# Explicit trusted bootstrap only. Run npm run db:bootstrap-recruiter after migrations/seeding.
# Never expose these values through public signup or commit real credentials.
RECRUITER_EMAIL=recruiter@careers.local
RECRUITER_PASSWORD=ChangeThisDemoPassword123!
RECRUITER_NAME=Demo Recruiter

# Private resume storage must remain outside public/ and static hosting.
CAREERS_UPLOAD_DIR=./data/private-uploads
# Existing SQLite file and its upload directory are retained for the one-time data import.
# CAREERS_DB_PATH=./data/careers.sqlite
# SQLITE_UPLOAD_DIR=./data/private-uploads
