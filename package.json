{
  "name": "job-tracker-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "db:seed": "node scripts/seed-postgres.mjs",
    "db:bootstrap-recruiter": "node scripts/bootstrap-recruiter.mjs",
    "db:import-sqlite": "node scripts/migrate-sqlite-to-postgres.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "postgres": "3.4.9",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^7"
  }
}
